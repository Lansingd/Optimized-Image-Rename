<Window x:Class="ImageRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一画室智能图片命名" Height="560" Width="684"
        Icon="pack://application:,,,/Resources/icon.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 文件设置 -->
            <RowDefinition Height="Auto"/>
            <!-- 识别设置 -->
            <RowDefinition Height="Auto"/>
            <!-- 文件夹设置 -->
            <RowDefinition Height="*"/>
            <!-- 日志 -->
            <RowDefinition Height="Auto"/>
            <!-- 控制区 -->
        </Grid.RowDefinitions>

        <!-- 文件设置 -->
        <GroupBox Header="文件设置" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Width="150" Margin="0,0,10,6" Click="OnPickFolder">选择图片文件夹</Button>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtFolder" VerticalAlignment="Center" Text="未选择" TextWrapping="Wrap"/>

                <Button Grid.Row="1" Grid.Column="0" Width="150" Margin="0,0,10,0" Click="OnPickNameFile">选择姓名库文件</Button>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtNameFile" VerticalAlignment="Center" Text="未选择" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <!-- 识别设置 -->
        <GroupBox Header="识别设置" Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="0" x:Name="ChkPreprocess" Content="启用图像预处理" Margin="0,0,18,0" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ChkFull" Content="全图识别模式" IsChecked="True" Margin="0,0,18,0" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="0" Grid.Column="2" x:Name="ChkSingleFallback" Content="单字兜底匹配" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0"
                           Text="形近字映射文件（同目录 similar_map.txt 可选）"/>
            </Grid>
        </GroupBox>

        <!-- 文件夹设置 -->
        <GroupBox Header="文件夹设置" Grid.Row="2" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" x:Name="ChkAutoFolder" Content="自动建立文件夹"
                          Padding="5,0,0,0" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="BtnPickDest" Content="选择建立文件夹位置" Width="140" Margin="0,0,10,0"
                        Click="OnPickDestRoot"/>
                <TextBox Grid.Column="2" x:Name="TxtDestRoot" IsReadOnly="True" Width="Auto"
                         ToolTip="不选时默认建立在图片文件夹下"
                         BorderThickness="1" Background="{x:Null}" BorderBrush="{x:Null}"/>
            </Grid>
        </GroupBox>

        <!-- 日志 -->
        <GroupBox Header="处理日志" Grid.Row="3" Margin="0,0,0,10">
            <Grid>
                <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <!-- 控制区 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <ProgressBar x:Name="Bar" Width="460" Height="20" Margin="0,0,10,0"/>
            <Button x:Name="BtnStart" Content="开始处理" Width="100" Margin="0,0,8,0" Click="OnStart"/>
            <Button x:Name="BtnStop"  Content="停止" Width="80" Click="OnStop"/>
        </StackPanel>
    </Grid>
</Window>
